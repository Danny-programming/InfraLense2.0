// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  password      String
  name          String
  role          String     @default("CITIZEN") // CITIZEN or ADMIN
  petitions     Petition[]
  complaints    Complaint[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  notifications Notification[]
}

model Petition {
  id              String   @id @default(cuid())
  title           String
  content         String
  locationName    String
  latitude        Float
  longitude       Float
  severityScore   Float
  population      Int
  status          String   @default("PENDING") // PENDING, REVIEWING, SUBMITTED, RESOLVED
  creator         User     @relation(fields: [creatorId], references: [id])
  creatorId       String
  targetAuthority String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updates         ProjectUpdate[] @relation("PetitionUpdates")
}

model AnalyticsLog {
  id           String   @id @default(cuid())
  locationName String
  lat          Float
  lng          Float
  data         String   // JSON stringified
  createdAt    DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  priority  String   @default("INFO") // INFO, WARNING, CRITICAL
  createdAt DateTime @default(now())
}

model Complaint {
  id          String   @id @default(cuid())
  category    String
  description String?
  imageUrl    String
  latitude    Float
  longitude   Float
  severity    Int
  status      String   @default("PENDING")
  creator     User     @relation(fields: [creatorId], references: [id])
  creatorId   String
  rejectionReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updates     ProjectUpdate[] @relation("ComplaintUpdates")
}

model ProjectUpdate {
  id          String   @id @default(cuid())
  stage       Int      @default(1) // 1-7 (BMC Lifecycle stages)
  title       String   // e.g., "Administrative Approval Received"
  description String?  // e.g., "Budget allocated for lane expansion."
  timestamp   DateTime @default(now())
  
  petitionId  String?
  petition    Petition? @relation("PetitionUpdates", fields: [petitionId], references: [id])
  
  complaintId String?
  complaint   Complaint? @relation("ComplaintUpdates", fields: [complaintId], references: [id])

  @@index([petitionId])
  @@index([complaintId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, PROJECT_UPDATE
  read      Boolean  @default(false)
  link      String?  // Optional link to project
  createdAt DateTime @default(now())

  @@index([userId])
}
